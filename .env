# SmartLedger Frontend Environment Configuration

# Set to true to use the built-in stateful mock engine
# Set to false to connect to the real FastAPI backend
VITE_USE_MOCKS=true

# FastAPI Backend Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Authentication feature flag (default: false)
# false = direct access to all pages without login
# true  = requires login, validates JWT tokens
VITE_AUTH_ENABLED=false
